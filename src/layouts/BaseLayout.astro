---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Syamsul Arifin, engineer, learning to write. Notes on code, books, and thinking slowly."
} = Astro.props;

function parseThemeCookie(cookie?: string): 'light' | 'dark' | null {
  const match = cookie?.match(/(?:^|; )theme=(light|dark)(?:;|$)/);
  return match?.[1] as 'light' | 'dark' | null ?? null;
}

const storedTheme = parseThemeCookie(Astro.request.headers.get('cookie') ?? undefined);
const systemDark = Astro.request.headers.get('sec-ch-prefers-color-scheme') === 'dark';
const resolvedTheme = storedTheme ?? (systemDark ? 'dark' : 'light');
const themeColor = resolvedTheme === 'dark' ? '#101C1E' : '#F2F0EF';
---

<!doctype html>
<html lang="en" data-theme={resolvedTheme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png+xml" href="/favicon.png" />
  <link rel="alternate" type="application/rss+xml" title="Syamsul Arifin" href="/rss.xml" />
  <meta name="theme-color" content={themeColor} />
  <script is:inline>
    // Static builds cannot read per-request cookies, so the client must be
    // authoritative. Read the cookie first, then fall back to system preference.
    (() => {
      const html = document.documentElement;
      const match = document.cookie.match(/(?:^|; )theme=(light|dark)(?:;|$)/);
      const theme = match
        ? match[1]
        : window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      html.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute(
        'content',
        theme === 'dark' ? '#101C1E' : '#F2F0EF'
      );
    })();
  </script>
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <title>{title}</title>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
