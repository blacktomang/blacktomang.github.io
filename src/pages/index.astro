---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/format";

const writingEntries = (
  await getCollection("writing", ({ data }) => !data.draft)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);

const readingNow = (await getCollection("reading"))
  .filter((e) => e.data.status === "reading")
  .slice(0, 3);
---

<BaseLayout title="Syamsul Arifin">
  <section class="hero" aria-labelledby="hero-title">
    <p class="hero-kicker">
      <span>Full-stack engineer</span>
      <span>Indonesia</span>
    </p>

    <h1 id="hero-title">
      Hi, I'm Syam.<br />
      <span>I'm currently</span>
      <span class="availability">
        <span aria-hidden="true"></span>
        Open to a new role
      </span>
    </h1>

    <div class="hero-detail">
      <p class="hero-intro">
        I work across product and infrastructure with React, TypeScript,
        Node.js, and Laravel, from user-facing features to the systems behind
        them.
      </p>
      <div class="hero-proof" aria-live="polite" aria-atomic="true">
        <span>Recent work</span>
        <span class="work-rotator">
          {[
            "Cut infrastructure costs by 50% and improved SEO scores by 30% at eBuddy.",
            "Restored SSR and eliminated a blank initial page by removing a Redux Persist conflict at eBuddy.",
            "Shipped AWS Rekognition selfie verification across web and mobile at eBuddy.",
            "Led the Firestore-to-Typesense migration on GCP for faster, cheaper search at eBuddy.",
            "Restructured Firestore data and virtualized lists to remove indexing bottlenecks at eBuddy.",
            "Reduced Laravel backend response times by 50% through query optimization at Score Campus.",
            "Built real-time chat and Google Calendar scheduling for an EdTech platform at Score Campus.",
            "Led frontend architecture for e-commerce and client projects at Tjal Technology Studio.",
            "Rendered live OpenStreetMap delivery routes with WebSockets and polling fallback.",
            "Introduced Next.js, TypeScript, TanStack Query, and resilient Axios retry handling.",
            "Delivered e-commerce, affiliate, retail, and enterprise projects end to end at Alfath Tech.",
            "Built Midtrans payments, webhooks, and scheduled background jobs for Halal Export Indonesia.",
            "Shipped the CC GOLD Flutter retail app with Firebase OTP authentication.",
            "Proposed scoped JWT authentication for secure cross-app access at Fishlog.",
          ].map((item, i) => (
            <span
              class={`work-rotator-item${i === 0 ? " is-active" : ""}`}
              data-index={i}
              aria-hidden={i !== 0}
            >
              {item.split(" ").map((word, wi, arr) => (
                <>
                  <span
                    class="work-rotator-word"
                    data-word={wi}
                    style={{ transitionDelay: `${wi * 260}ms` }}
                  >
                    {word}
                  </span>
                  {wi < arr.length - 1 && <span> </span>}
                </>
              ))}
            </span>
          ))}
        </span>
      </div>
    </div>
  </section>

  {
    writingEntries.length > 0 && (
      <section>
        <h2 class="eyebrow">Recent writing</h2>
        <ul class="post-list">
          {writingEntries.map((entry) => (
            <li>
              <a href={`/writing/${entry.id}/`}>{entry.data.title}</a>
              <p class="meta">
                {formatDate(entry.data.publishedAt)}
                {entry.data.readingTime
                  ? ` · ${entry.data.readingTime} min`
                  : ""}
              </p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/writing/" class="quiet">
            All writing →
          </a>
        </p>
      </section>
    )
  }

  {
    readingNow.length > 0 && (
      <section>
        <h2 class="eyebrow">Reading now</h2>
        <ul class="book-list">
          {readingNow.map((entry) => (
            <li>
              <a href={`/reading/${entry.id}/`}>{entry.data.title}</a>
              <p class="meta">{entry.data.author}</p>
            </li>
          ))}
        </ul>
        <p>
          <a href="/reading/" class="quiet">
            All reading →
          </a>
        </p>
      </section>
    )
  }
</BaseLayout>

<script>
  (function () {
    const rotators = document.querySelectorAll(".work-rotator");
    if (!rotators.length) return;

    rotators.forEach((rotator) => {
      const items = Array.from(rotator.querySelectorAll(".work-rotator-item"));
      if (items.length < 2) return;

      let activeIndex = 0;
      let readTimeout: ReturnType<typeof setTimeout> | null = null;

      function measureMaxHeight() {
        rotator.classList.add("is-setting-up");
        rotator.classList.add("is-measuring");
        rotator.classList.remove("is-ready");
        // Force layout so the measuring styles are applied before reading sizes.
        rotator.getBoundingClientRect();
        const max = Math.max(
          ...items.map((item) => item.getBoundingClientRect().height)
        );
        (rotator as HTMLElement).style.setProperty(
          "--rotator-height",
          `${Math.ceil(max)}px`
        );
        rotator.classList.add("is-ready");
        rotator.classList.remove("is-measuring");
        rotator.getBoundingClientRect();
        rotator.classList.remove("is-setting-up");
      }

      function revealWords(item: Element) {
        item.querySelectorAll(".work-rotator-word").forEach((word) => {
          word.classList.add("is-visible");
        });
      }

      function resetWords(item: Element) {
        item.querySelectorAll(".work-rotator-word").forEach((word) => {
          word.classList.remove("is-visible");
        });
      }

      function scheduleNext(item: Element) {
        const words = item.querySelectorAll(".work-rotator-word");
        const lastWord = words[words.length - 1] as HTMLElement | undefined;
        if (!lastWord) return 2000;

        const lastDelay = parseFloat(lastWord.dataset.word || "0") * 260;
        const lastDuration = 500;
        return lastDelay + lastDuration + 1400;
      }

      function setActive(nextIndex: number) {
        const leaving = items[activeIndex];
        const entering = items[nextIndex];
        activeIndex = nextIndex;

        leaving.classList.add("is-leaving");
        leaving.classList.remove("is-active");
        leaving.setAttribute("aria-hidden", "true");

        entering.classList.add("is-active");
        entering.classList.remove("is-leaving");
        entering.setAttribute("aria-hidden", "false");

        revealWords(entering);

        const onLeaveDone = () => {
          leaving.classList.remove("is-leaving");
          resetWords(leaving);
          leaving.removeEventListener("transitionend", onLeaveDone);
        };
        leaving.addEventListener("transitionend", onLeaveDone);

        if (readTimeout) clearTimeout(readTimeout);
        readTimeout = setTimeout(() => {
          setActive((activeIndex + 1) % items.length);
        }, scheduleNext(entering));
      }

      measureMaxHeight();
      window.addEventListener("resize", measureMaxHeight);
      revealWords(items[activeIndex]);

      readTimeout = setTimeout(() => {
        setActive((activeIndex + 1) % items.length);
      }, scheduleNext(items[activeIndex]));
    });
  })();
</script>

<style>
  .hero {
    margin: clamp(2.5rem, 8vw, 5.5rem) 0 var(--space-xl);
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
    border-bottom: 1px solid var(--rule);
  }

  .availability {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    /* margin: 0 0 var(--space-md); */
    padding: 0.48rem 0.78rem 0.46rem;
    border: 1px solid rgb(var(--accent-rgb) / 0.35);
    border-radius: 999px;
    background: rgb(var(--accent-rgb) / 0.055);
    box-shadow:
      inset 0 1px 0 rgb(var(--ink-rgb) / 0.05),
      0 0 0 1px rgb(var(--paper-rgb) / 0.4),
      0 0.35rem 1.2rem rgb(var(--ink-rgb) / 0.12);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: default;
    transition:
      border-color 220ms ease,
      background-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .availability::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 25%,
      rgb(var(--ink-rgb) / 0.1) 45%,
      transparent 65%
    );
    transform: translateX(-120%);
    transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .availability:hover {
    border-color: rgb(var(--accent-rgb) / 0.68);
    background: rgb(var(--accent-rgb) / 0.09);
    box-shadow:
      inset 0 1px 0 rgb(var(--ink-rgb) / 0.08),
      0 0 0 1px rgb(var(--paper-rgb) / 0.45),
      0 0.45rem 1.5rem rgb(var(--accent-rgb) / 0.09);
    transform: translateY(-2px);
  }
  .availability:hover::after {
    transform: translateX(120%);
  }
  .availability:active {
    transform: translateY(0) scale(0.985);
  }
  .availability span {
    position: relative;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 0 0.2rem rgb(var(--accent-rgb) / 0.12),
      0 0 0.8rem rgb(var(--accent-rgb) / 0.5);
  }
  .availability span::after {
    content: "";
    position: absolute;
    inset: -0.28rem;
    border: 1px solid rgb(var(--accent-rgb) / 0.5);
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .availability span::after {
      animation: status-pulse 2.4s ease-out infinite;
    }
  }

  @keyframes status-pulse {
    0%,
    35% {
      opacity: 0;
      transform: scale(0.55);
    }
    45% {
      opacity: 0.65;
    }
    85%,
    100% {
      opacity: 0;
      transform: scale(1.45);
    }
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 clamp(1.5rem, 4vw, 2.5rem);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hero-kicker span + span {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-kicker span + span::before {
    content: "";
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
  }

  .hero h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .hero h1 span {
    color: var(--accent);
    font-weight: 400;
  }

  .hero-detail {
    display: grid;
    gap: var(--space-md);
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }
  .hero-detail p {
    margin: 0;
  }

  .hero-intro {
    max-width: 35rem;
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }

  .hero-proof {
    padding-left: 1rem;
    border-left: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .hero-proof > span:first-child {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .work-rotator {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .work-rotator.is-ready {
    height: var(--rotator-height, auto);
  }

  .work-rotator-item {
    display: none;
  }
  .work-rotator-item.is-active {
    display: block;
  }

  .work-rotator.is-ready .work-rotator-item {
    position: absolute;
    inset: 0;
    display: block;
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 400ms ease;
  }
  .work-rotator.is-ready .work-rotator-item.is-active {
    transform: translateY(0);
    opacity: 1;
  }
  .work-rotator.is-ready .work-rotator-item.is-leaving {
    transform: translateY(-100%);
    opacity: 0;
  }

  .work-rotator.is-measuring .work-rotator-item {
    position: relative;
    display: block;
    visibility: hidden;
    transform: none;
    opacity: 1;
  }

  .work-rotator-word {
    display: inline-block;
    opacity: 0.35;
    transform: translateY(0.15em);
    transition:
      opacity 500ms ease,
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .work-rotator-word.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* No-JS fallback: the first active item is fully visible without animation. */
  .work-rotator:not(.is-ready) .work-rotator-item.is-active .work-rotator-word {
    opacity: 1;
    transform: none;
    transition: none;
  }

  /* Freeze transitions while the rotator switches from SSR static layout to the animated state. */
  .work-rotator.is-setting-up .work-rotator-item,
  .work-rotator.is-setting-up .work-rotator-word {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-rotator,
    .work-rotator.is-ready {
      overflow: visible;
      height: auto;
    }
    .work-rotator-item,
    .work-rotator.is-ready .work-rotator-item {
      position: static;
      transform: none;
      opacity: 1;
      display: none;
    }
    .work-rotator-item.is-active,
    .work-rotator.is-ready .work-rotator-item.is-active {
      display: block;
    }
    .work-rotator-word,
    .work-rotator.is-ready .work-rotator-word,
    .work-rotator.is-ready .work-rotator-word.is-visible {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .hero-detail {
      grid-template-columns: minmax(0, 1fr) 15rem;
      align-items: end;
    }
  }

  section + section {
    margin-top: var(--space-xl);
  }

  .post-list,
  .book-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li,
  .book-list li {
    margin-bottom: var(--space-md);
  }
  .post-list a,
  .book-list a {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
  }
  .post-list a:hover,
  .book-list a:hover {
    color: var(--accent);
  }
  .post-list .meta,
  .book-list .meta {
    margin-top: 0.25em;
  }

  .quiet {
    color: var(--ink-soft);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .quiet:hover {
    color: var(--accent);
  }
</style>
