---
import GithubIcon from "./icons/Github.astro";
import LinkedinIcon from "./icons/Linkedin.astro";
import NowIcon from "./icons/Now.astro";
import RssIcon from "./icons/Rss.astro";
import ThreadsIcon from "./icons/Threads.astro";

// Edit this line by hand whenever the situation changes.
// The month stamp at the end makes staleness visible if you forget.
const currently = "drafting essays I've been meaning to write, May 2026";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p class="currently">
      <span class="currently-label">Currently</span>
      <span class="currently-text">{currently}</span>
    </p>

    <div class="footer-row">
      <p class="copy">Syamsul Arifin · {new Date().getFullYear()}</p>
      <nav class="social" aria-label="Elsewhere">
        <a href="/now/" aria-label="Now page">
          <NowIcon size={14} />
        </a>
        <a href="https://github.com/blacktomang" rel="me">
          <GithubIcon size={14} />
          <!-- <span>GitHub</span> -->
        </a>
        <a href="https://www.threads.com/@arifsaqa" rel="me">
          <ThreadsIcon size={14} />
          <!-- <span>Threads</span> -->
        </a>
        <a href="https://www.linkedin.com/in/syammarif/" rel="me">
          <LinkedinIcon size={14} />
        </a>
        <a href="/rss.xml" aria-label="RSS feed">
          <RssIcon size={14} />
        </a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--space-xl);
  }
  .site-footer-inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .currently {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
  }
  .currently-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-right: 0.6em;
    vertical-align: 0.1em;
  }
  .currently-text {
    font-style: italic;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm) var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }
  .copy {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin: 0;
    letter-spacing: 0.04em;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .social a:hover { color: var(--accent); }
</style>
