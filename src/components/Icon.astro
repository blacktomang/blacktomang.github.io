---
import GithubIcon from "./icons/Github.astro";
import LinkedinIcon from "./icons/Linkedin.astro";
import RssIcon from "./icons/Rss.astro";
import ThreadsIcon from "./icons/Threads.astro";

interface Props {
  name: "github" | "linkedin" | "rss" | "threads";
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

{
  name === "github" ? (
    <GithubIcon size={size} />
  ) : name === "linkedin" ? (
    <LinkedinIcon size={size} />
  ) : name === "rss" ? (
    <RssIcon size={size} />
  ) : (
    <ThreadsIcon size={size} />
  )
}
