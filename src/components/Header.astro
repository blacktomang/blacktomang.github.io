---
const path = Astro.url.pathname;
const isHome = path === '/' || path === '';

const navItems = [
  { href: '/writing/', label: 'Writing' },
  { href: '/notes/', label: 'Notes' },
  { href: '/reading/', label: 'Reading' },
  { href: '/projects/', label: 'Projects' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="site-header-inner">
    {isHome ? (
      <span class="brand" aria-label="Syamsul Arifin">
        <svg class="brand-logo" viewBox="0 0 256 256" aria-hidden="true">
          <path class="brand-path brand-shadow" d="M104 67C78 57 57 70 57 94c0 24 19 34 43 44 18 8 26 16 25 28-1 18-24 28-47 18-12-5-21-12-29-23" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
          <path class="brand-path brand-shadow" d="M111 190 149 63l51 127m-41-49h35" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
          <path class="brand-path brand-primary" d="M104 67C78 57 57 70 57 94c0 24 19 34 43 44 18 8 26 16 25 28-1 18-24 28-47 18-12-5-21-12-29-23" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path class="brand-path brand-accent" d="M111 190 149 63l51 127m-41-49h35" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path class="brand-path brand-primary" d="M111 190 130 126" fill="none" stroke-width="4" stroke-linecap="round"/>
        </svg>
      </span>
    ) : (
      <a href="/" class="brand" aria-label="Syamsul Arifin">
        <svg class="brand-logo" viewBox="0 0 256 256" aria-hidden="true">
          <path class="brand-path brand-shadow" d="M104 67C78 57 57 70 57 94c0 24 19 34 43 44 18 8 26 16 25 28-1 18-24 28-47 18-12-5-21-12-29-23" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
          <path class="brand-path brand-shadow" d="M111 190 149 63l51 127m-41-49h35" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
          <path class="brand-path brand-primary" d="M104 67C78 57 57 70 57 94c0 24 19 34 43 44 18 8 26 16 25 28-1 18-24 28-47 18-12-5-21-12-29-23" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path class="brand-path brand-accent" d="M111 190 149 63l51 127m-41-49h35" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path class="brand-path brand-primary" d="M111 190 130 126" fill="none" stroke-width="4" stroke-linecap="round"/>
        </svg>
      </a>
    )}

    <div class="header-actions">
      <nav class="primary-nav-inline" aria-label="Primary">
        {navItems.map(item => (
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
        <span class="nav-underline" aria-hidden="true"></span>
      </nav>

      <button type="button" class="theme-toggle" aria-label="Toggle color theme">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
        </svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 15.2A8.4 8.4 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"></path>
        </svg>
      </button>

      <button
        type="button"
        class="nav-toggle"
        aria-haspopup="dialog"
        aria-controls="nav-dialog"
      >
        Menu
      </button>
    </div>

    <dialog id="nav-dialog" class="nav-dialog" aria-label="Site navigation">
      <button type="button" class="nav-close" aria-label="Close menu">
        Close
      </button>
      <nav class="dialog-nav" aria-label="Primary">
        {navItems.map(item => (
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>
    </dialog>
  </div>
</header>

<script>
  function positionUnderline(underline: HTMLElement, target: HTMLElement) {
    const nav = underline.parentElement;
    if (!nav) return;
    const navRect = nav.getBoundingClientRect();
    const rect = target.getBoundingClientRect();
    underline.style.left = `${rect.left - navRect.left}px`;
    underline.style.width = `${rect.width}px`;
  }

  // Trigger SA logo path draw on first render.
  function animateBrandOnce() {
    const paths = document.querySelectorAll<SVGPathElement>('.brand-path');
    if (!paths.length) return;
    paths.forEach(path => {
      path.style.setProperty('--path-length', String(path.getTotalLength()));
      path.classList.remove('is-drawn');
      void path.getBoundingClientRect();
      path.classList.add('is-drawn');
    });
  }
  animateBrandOnce();

  // Sticky header state based on scroll position.
  function updateHeaderScroll() {
    const header = document.querySelector('.site-header');
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 4);
  }
  window.addEventListener('scroll', updateHeaderScroll, { passive: true });
  updateHeaderScroll();

  // On load (and after each View Transition swap), anchor the underline
  // under the active item so the current section is always marked.
  function initUnderline() {
    const underline = document.querySelector<HTMLElement>('.nav-underline');
    if (!underline) return;
    const active = document.querySelector<HTMLAnchorElement>('.primary-nav-inline a.active');
    if (active) {
      positionUnderline(underline, active);
      underline.classList.add('is-visible');
    } else {
      underline.classList.remove('is-visible');
    }
  }
  document.addEventListener('astro:page-load', initUnderline);
  initUnderline();

  type Theme = 'light' | 'dark';

  function updateThemeToggle(theme: Theme) {
    const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
    const nextTheme = theme === 'dark' ? 'light' : 'dark';
    toggle?.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
    toggle?.setAttribute('title', `Switch to ${nextTheme} theme`);
  }

  function setThemeCookie(theme: Theme) {
    const maxAge = 60 * 60 * 24 * 365;
    try {
      document.cookie = `theme=${theme};path=/;max-age=${maxAge};SameSite=Lax`;
    } catch {}
  }

  function applyTheme(theme: Theme, persist = false) {
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      'content',
      theme === 'dark' ? '#101C1E' : '#F2F0EF'
    );
    updateThemeToggle(theme);

    if (persist) {
      setThemeCookie(theme);
    }
  }

  const currentTheme = document.documentElement.dataset.theme;
  updateThemeToggle(currentTheme === 'dark' ? 'dark' : 'light');

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
    const hasStored = /(?:^|; )theme=(?:light|dark)(?:;|$)/.test(document.cookie);
    if (hasStored) return;
    applyTheme(event.matches ? 'dark' : 'light');
  });

  // Event delegation on `document` survives Astro's View Transition DOM swaps,
  // so the menu keeps working after every navigation without re-binding.
  document.addEventListener('mouseover', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const link = target.closest<HTMLAnchorElement>('.primary-nav-inline a');
    const underline = document.querySelector<HTMLElement>('.nav-underline');
    if (!link || !underline) return;

    // Moving from one item to another: collapse the underline into a dot,
    // then glide to the new item and re-expand into an underline.
    if (underline.classList.contains('is-visible')) {
      underline.classList.add('is-morphing');
      window.setTimeout(() => {
        positionUnderline(underline, link);
        underline.classList.remove('is-morphing');
      }, 180);
    } else {
      positionUnderline(underline, link);
    }

    underline.classList.add('is-visible');
  });

  document.addEventListener('mouseout', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const nav = target.closest<HTMLElement>('.primary-nav-inline');
    if (nav) return;

    const underline = document.querySelector<HTMLElement>('.nav-underline');
    if (!underline) return;

    // Return to the active item, or hide if there is none.
    const active = document.querySelector<HTMLAnchorElement>('.primary-nav-inline a.active');
    if (active) {
      positionUnderline(underline, active);
      underline.classList.add('is-visible');
    } else {
      underline.classList.remove('is-visible');
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    if (target.closest('.theme-toggle')) {
      const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      applyTheme(theme, true);
      return;
    }

    const dialog = document.querySelector<HTMLDialogElement>('#nav-dialog');
    if (!dialog) return;

    if (target.closest('.nav-toggle')) {
      dialog.showModal();
      return;
    }
    if (target.closest('.nav-close')) {
      dialog.close();
      return;
    }
    // Click on the dialog element itself = backdrop click
    if (target === dialog) {
      dialog.close();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      backdrop-filter 220ms ease;
  }
  .site-header.is-scrolled {
    background: rgb(var(--paper-rgb) / 0.82);
    border-color: var(--rule);
    backdrop-filter: blur(10px);
  }
  .site-header-inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }
  .brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    isolation: isolate;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-logo {
    width: 2.4rem;
    height: auto;
    display: block;
    overflow: visible;
  }
  .brand-path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .brand-primary { stroke: var(--ink); }
  .brand-accent { stroke: var(--accent-warm); }
  .brand-shadow { stroke: var(--rule); opacity: 0.35; }
  .brand-path.is-drawn {
    stroke-dasharray: var(--path-length);
    stroke-dashoffset: var(--path-length);
    animation: draw-path 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .brand:hover .brand-primary { stroke: var(--accent); }
  .brand:hover .brand-accent { stroke: var(--accent); }
  @keyframes draw-path {
    to { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-path.is-drawn {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
  a.brand:hover { color: var(--accent); }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-deep);
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: rotate(12deg);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .theme-icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
  .theme-icon-sun { display: none; }
  :global(html[data-theme='dark']) .theme-icon-sun { display: block; }
  :global(html[data-theme='dark']) .theme-icon-moon { display: none; }

  /* Mobile: menu button visible, inline nav hidden */
  .primary-nav-inline { display: none; }

  .nav-toggle {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0.25rem 0.4rem;
  }
  .nav-toggle:hover { color: var(--accent); }

  /* Desktop: inline nav visible, menu button hidden */
  @media (min-width: 720px) {
    .primary-nav-inline {
      position: relative;
      display: flex;
      gap: 1.4rem;
    }
    .primary-nav-inline a {
      position: relative;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      letter-spacing: 0.12em;
      color: var(--ink-soft);
      text-decoration: none;
      text-transform: uppercase;
    }
    .primary-nav-inline a:hover,
    .primary-nav-inline a.active {
      color: var(--accent);
    }

    /* Shared underline that slides between items; width collapses to a dot in transit */
    .nav-underline {
      position: absolute;
      bottom: -0.3rem;
      height: 2px;
      width: 0;
      background: var(--accent);
      border-radius: 2px;
      pointer-events: none;
      opacity: 0;
      transition:
        left 320ms cubic-bezier(0.22, 1, 0.36, 1),
        width 320ms cubic-bezier(0.22, 1, 0.36, 1),
        border-radius 320ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 200ms ease;
    }
    .nav-underline.is-visible {
      opacity: 1;
    }
    .nav-underline.is-morphing {
      width: 1px;
      /* border-radius: 50%; */
    }

    .nav-toggle { display: none; }
  }

  /* Dialog (mobile only) */
  .nav-dialog {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0;
    margin: auto;
    width: min(420px, calc(100% - 2rem));
    max-width: calc(100% - 2rem);
    box-shadow: var(--dialog-shadow);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transition:
      opacity 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      overlay 220ms allow-discrete,
      display 220ms allow-discrete;
  }
  .nav-dialog[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .nav-dialog[open] {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .nav-dialog::backdrop {
    background: var(--dialog-backdrop);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition:
      opacity 220ms ease-out,
      overlay 220ms allow-discrete,
      display 220ms allow-discrete;
  }
  .nav-dialog[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .nav-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  .nav-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
    padding: 0.25rem 0.4rem;
  }
  .nav-close:hover { color: var(--accent); }

  .dialog-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
  }
  .dialog-nav a {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
    font-weight: 500;
  }
  .dialog-nav a:hover,
  .dialog-nav a.active {
    color: var(--accent);
  }
</style>
